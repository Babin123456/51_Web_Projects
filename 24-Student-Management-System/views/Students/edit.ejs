<% layout('Students/layouts/boilerPlate') %>
<%- include('partials/navbar') %>

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0 p-4">
                <h3 class="fw-bold mb-4">Edit Student Profile</h3>

                <% if (typeof error !== 'undefined' && error) { %>
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <strong>Error:</strong> <%= error %>
                    </div>
                <% } %>

                <form action="/students/<%= stu.id %>?_method=PATCH" method="POST">
                    <div class="mb-3">
                        <label for="name" class="form-label fw-semibold">Student Name *</label>
                        <input type="text" class="form-control" id="name" name="name" value="<%= stu.name %>" required>
                    </div>

                    <div class="mb-3">
                        <label for="roll" class="form-label fw-semibold">Roll Number *</label>
                        <input type="number" min="1" class="form-control" id="roll" name="roll" value="<%= stu.roll %>" required>
                    </div>

                    <div class="mb-3">
                        <label for="section" class="form-label fw-semibold">Section *</label>
                        <select class="form-select" id="section" name="section" required>
                            <option value="A" <%= stu.section === 'A' ? 'selected' : '' %>>Section A</option>
                            <option value="B" <%= stu.section === 'B' ? 'selected' : '' %>>Section B</option>
                            <option value="C" <%= stu.section === 'C' ? 'selected' : '' %>>Section C</option>
                        </select>
                    </div>

                    <div class="mb-4">
                        <label for="img" class="form-label fw-semibold">Profile Photo URL</label>
                        <input type="url" class="form-control" id="img" name="img" value="<%= stu.img %>">
                    </div>

                    <div class="d-flex justify-content-between align-items-center">
                        <a href="/students/<%= stu.id %>" class="btn btn-outline-secondary">Discard</a>
                        <button type="submit" class="btn btn-primary px-4">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>